# Copy this file to .env and fill in the secrets before running the app.
# Required by api-translate-rt/app.py
AUDIO_API_KEY=replace-with-your-audio-api-token
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional overrides for the translation provider
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini

# Optional services
DIARIZATION_TOKEN=
TTS_API_KEY=
TTS_API_URL=https://api-txt2audio.cloud-pi-native.com/v1/audio/speech

# Optional runtime controls
API_TOKENS=
VAD_AGGR=2
SERVER_NAME=0.0.0.0
SERVER_PORT=5000
BACK_PORT=5001
