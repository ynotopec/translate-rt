# Required for api-translate-rt: token used to call the transcription API.
AUDIO_API_KEY=

# Required for api-translate-rt: token used to call the OpenAI-compatible translation API.
OPENAI_API_KEY=

# Required for api-translate-rt: OpenAI-compatible API base URL, without a trailing slash.
OPENAI_API_SCHEME=https
OPENAI_API_HOST=api.openai.com
OPENAI_API_BASE=${OPENAI_API_SCHEME}://${OPENAI_API_HOST}/v1

# Optional: model used for translation chat completions.
#OPENAI_API_MODEL=gpt-4o-mini

# Optional: bind address and port. run.sh [IP] [PORT] overrides these.
#SERVER_NAME=0.0.0.0
#SERVER_PORT=8080

# Optional: protect API routes with Authorization: Bearer <token>.
#TRANSLATE_RT_API_TOKEN=

# Optional: backend API URL consumed by the Flask frontend.
#TRANSLATE_RT_API_BASE=http://localhost:8080
#TRANSLATE_RT_UPLOAD_URL=${TRANSLATE_RT_API_BASE}/upload
#TRANSLATE_RT_TTS_URL=${TRANSLATE_RT_API_BASE}/tts-proxy

# Optional: upstream provider URL building blocks used by the URLs below.
AI_DEV_API_SCHEME=https
AI_DEV_API_DOMAIN=ai-dev.numerique-interieur.com

# Optional: diarization provider.
#DIARIZATION_TOKEN=
#DIAR_URL=${AI_DEV_API_SCHEME}://api-diarization.${AI_DEV_API_DOMAIN}/upload-audio/

# Optional: text-to-speech provider.
#TTS_API_KEY=
#TTS_API_URL=${AI_DEV_API_SCHEME}://api-txt2audio.${AI_DEV_API_DOMAIN}/v1/audio/speech

# Optional: transcription provider and model.
#WHISPER_URL=${AI_DEV_API_SCHEME}://api-audio2txt.${AI_DEV_API_DOMAIN}/v1/audio/transcriptions
#STT_MODEL=whisper-1

# Optional: HTTP/runtime tuning. H100/DGX Spark runs work with the CPU-only defaults.
#REQUEST_TIMEOUT=30
#MAX_CACHE_SIZE=256
#CORS_ALLOW_ORIGINS=*
#CORS_ALLOW_CREDENTIALS=false
