# Required for api-translate-rt: token used to call the transcription API.
AUDIO_API_KEY=

# Required for api-translate-rt: token used to call the OpenAI-compatible translation API.
OPENAI_API_KEY=

# Required for api-translate-rt: OpenAI-compatible API base URL, without a trailing slash.
OPENAI_API_SCHEME=https
OPENAI_API_HOST=api.openai.com
OPENAI_API_BASE=${OPENAI_API_SCHEME}://${OPENAI_API_HOST}/v1

# Optional: model used for translation chat completions.
#OPENAI_API_MODEL=gpt-4o-mini

# Optional: bind address and port. run.sh [IP] [PORT] overrides these.
#SERVER_NAME=0.0.0.0
#SERVER_PORT=8080

# Optional: protect API routes with Authorization: Bearer <token>.
#TRANSLATE_RT_API_TOKEN=

# Required for the Flask frontend: backend API URL consumed by the browser.
TRANSLATE_RT_API_SCHEME=https
TRANSLATE_RT_API_HOST=api-translate-rt.ailab.infocepo.com
TRANSLATE_RT_API_BASE=${TRANSLATE_RT_API_SCHEME}://${TRANSLATE_RT_API_HOST}
# Optional: override individual frontend endpoints when they do not follow TRANSLATE_RT_API_BASE.
#TRANSLATE_RT_UPLOAD_URL=${TRANSLATE_RT_API_BASE}/upload
#TRANSLATE_RT_TTS_URL=${TRANSLATE_RT_API_BASE}/tts-proxy

# Optional: upstream provider URL building blocks used by the URLs below.
AI_DEV_API_SCHEME=https
AI_DEV_API_DOMAIN=ai-dev.numerique-interieur.com

# Optional: diarization provider.
#DIARIZATION_TOKEN=
#DIAR_URL=${AI_DEV_API_SCHEME}://api-diarization.${AI_DEV_API_DOMAIN}/upload-audio/

# Optional: text-to-speech provider.
#TTS_API_KEY=
#TTS_API_URL=${AI_DEV_API_SCHEME}://api-txt2audio.${AI_DEV_API_DOMAIN}/v1/audio/speech

# Optional: transcription provider and model.
#WHISPER_URL=${AI_DEV_API_SCHEME}://api-audio2txt.${AI_DEV_API_DOMAIN}/v1/audio/transcriptions
#STT_MODEL=whisper-1

# Optional: HTTP/runtime tuning. H100/DGX Spark runs work with the CPU-only defaults.
#REQUEST_TIMEOUT=30
#CORS_ALLOW_ORIGINS=*
#CORS_ALLOW_CREDENTIALS=false

# Per API worker; enforce shared/global quotas at the reverse proxy if needed.
#MAX_REQUEST_BYTES=12582912
#MAX_AUDIO_BYTES=10485760
#MAX_CONCURRENT_REQUESTS=32
#MAX_REQUESTS_PER_MINUTE=1200
# CORS is unnecessary for the bundled same-origin frontend.

# Exact public origin when Flask is behind TLS termination.
#FRONTEND_PUBLIC_ORIGIN=https://translate.example.gouv.fr
#PROXY_READ_TIMEOUT=120

# Default: public frontend and browser API calls, without login.
# Set mode=basic and both credentials below only to restrict access.
FRONTEND_AUTH_MODE=none
FRONTEND_AUTH_USER=
# Use single quotes around the generated hash to preserve literal $ characters.
FRONTEND_AUTH_PASSWORD_HASH=''
# Set mode=proxy only behind an authenticated SSO proxy with a private upstream.
# mode=none intentionally allows public anonymous access.
# Optional real security contact and expiry (RFC 3339, at most one year away).
#SECURITY_CONTACT=mailto:your-monitored-address
#SECURITY_EXPIRES=YYYY-MM-DDTHH:MM:SSZ
# Gunicorn binds localhost by default outside Docker.
#GUNICORN_WORKERS=2
#GUNICORN_THREADS=4
#GUNICORN_TIMEOUT=180
