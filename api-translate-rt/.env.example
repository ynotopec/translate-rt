# Required: token used to call the transcription API.
AUDIO_API_KEY=

# Required: token used to call the OpenAI-compatible translation API.
OPENAI_API_KEY=

# Required: OpenAI-compatible API base URL, without a trailing slash.
OPENAI_API_BASE=https://api.openai.com/v1

# Optional: model used for translation chat completions.
#OPENAI_API_MODEL=gpt-4o-mini

# Optional: bind address and port. run.sh [IP] [PORT] overrides these.
#SERVER_NAME=0.0.0.0
#SERVER_PORT=8080

# Optional: protect API routes with Authorization: Bearer <token>.
#TRANSLATE_RT_API_TOKEN=

# Optional: diarization provider.
#DIARIZATION_TOKEN=
#DIAR_URL=https://api-diarization.ai-dev.numerique-interieur.com/upload-audio/

# Optional: text-to-speech provider.
#TTS_API_KEY=
#TTS_API_URL=https://api-txt2audio.ai-dev.numerique-interieur.com/v1/audio/speech

# Optional: transcription provider and model.
#WHISPER_URL=https://api-audio2txt.ai-dev.numerique-interieur.com/v1/audio/transcriptions
#STT_MODEL=whisper-1

# Optional: HTTP/runtime tuning. H100/DGX Spark runs work with the CPU-only defaults.
#REQUEST_TIMEOUT=30
#MAX_CACHE_SIZE=256
#CORS_ALLOW_ORIGINS=*
#CORS_ALLOW_CREDENTIALS=false
